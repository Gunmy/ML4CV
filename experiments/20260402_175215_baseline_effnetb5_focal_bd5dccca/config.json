{
  "experiment_name": "baseline_effnetb5_focal",
  "description": "EfficientNet-B5 with Focal Loss, freeze 3 epochs, 456px",
  "seed": 42,
  "data_dir": "data",
  "experiments_root": "experiments",
  "test_split": 0.1,
  "val_split": 0.1,
  "min_samples_per_class": 1,
  "stratified_split": true,
  "backbone": "efficientnet_b5",
  "image_size": [
    456,
    456
  ],
  "pretrained": true,
  "embedding_dim": 512,
  "use_gem_pooling": false,
  "freeze_backbone_epochs": 3,
  "freeze_bn": true,
  "epochs": 30,
  "batch_size": 12,
  "accumulation_steps": 2,
  "num_workers": 2,
  "use_amp": true,
  "optimizer": "adamw",
  "lr_head": 0.001,
  "lr_backbone": 0.0001,
  "weight_decay": 0.0001,
  "max_grad_norm": 1.0,
  "scheduler": "cosine",
  "warmup_epochs": 1,
  "cosine_eta_min": 1e-06,
  "plateau_factor": 0.5,
  "plateau_patience": 3,
  "loss_type": "focal",
  "focal_gamma": 2.0,
  "focal_alpha": "class_weights",
  "label_smoothing": 0.1,
  "use_class_weights": true,
  "include_new_whale_in_val": true,
  "confidence_threshold": 0.5,
  "aug_random_resized_crop": true,
  "aug_crop_scale_min": 0.85,
  "aug_crop_scale_max": 1.0,
  "aug_rotation_degrees": 10,
  "aug_brightness": 0.2,
  "aug_contrast": 0.2,
  "aug_gaussian_blur": true,
  "aug_blur_sigma_min": 0.1,
  "aug_blur_sigma_max": 1.0,
  "early_stopping_patience": 8,
  "early_stopping_metric": "val_known_acc",
  "save_every_n_epochs": 1,
  "keep_top_k_checkpoints": 3
}