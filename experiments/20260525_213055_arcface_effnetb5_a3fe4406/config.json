{
  "experiment_name": "arcface_effnetb5",
  "description": "ArcFace angular margin loss, initialized from baseline",
  "seed": 42,
  "data_dir": "data",
  "experiments_root": "experiments",
  "test_split": 0.1,
  "val_split": 0.1,
  "min_samples_per_class": 1,
  "stratified_split": true,
  "backbone": "efficientnet_b5",
  "image_size": [
    456,
    456
  ],
  "pretrained": true,
  "embedding_dim": 512,
  "use_gem_pooling": false,
  "freeze_backbone_epochs": 2,
  "freeze_bn": true,
  "epochs": 20,
  "batch_size": 32,
  "accumulation_steps": 2,
  "num_workers": 2,
  "use_amp": true,
  "optimizer": "adamw",
  "lr_head": 0.0005,
  "lr_backbone": 5e-05,
  "weight_decay": 0.0001,
  "max_grad_norm": 1.0,
  "scheduler": "cosine",
  "warmup_epochs": 1,
  "cosine_eta_min": 1e-06,
  "plateau_factor": 0.5,
  "plateau_patience": 3,
  "loss_type": "arcface_ce",
  "focal_gamma": 2.0,
  "focal_alpha": "class_weights",
  "label_smoothing": 0.0,
  "use_class_weights": false,
  "include_new_whale_in_val": true,
  "confidence_threshold": 0.5,
  "aug_random_resized_crop": false,
  "aug_crop_scale_min": 0.85,
  "aug_crop_scale_max": 1.0,
  "aug_rotation_degrees": 10,
  "aug_brightness": 0.2,
  "aug_contrast": 0.2,
  "aug_gaussian_blur": true,
  "aug_blur_sigma_min": 0.1,
  "aug_blur_sigma_max": 1.0,
  "early_stopping_patience": 6,
  "early_stopping_metric": "val_known_acc",
  "save_every_n_epochs": 1,
  "keep_top_k_checkpoints": 3,
  "auto_resume": true,
  "head_type": "arcface",
  "arcface_scale": 30.0,
  "arcface_margin": 0.5,
  "triplet_margin": 0.3,
  "triplet_mining": "semi_hard",
  "contrastive_pos_margin": 0.2,
  "contrastive_neg_margin": 1.0,
  "pk_sampling": false,
  "pk_p": 16,
  "pk_k": 4,
  "pk_min_samples": 2,
  "init_from_checkpoint": null
}